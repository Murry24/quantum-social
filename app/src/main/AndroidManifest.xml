<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />



<application
        android:name=".lingua.QuantumApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Quantum Social"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuantumSocial">
    <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- bod 15: jemná večerná pripomienka -->
        <receiver
            android:name=".notify.GentleReminderReceiver"
            android:exported="false" />

        <!-- bod 33: živá tapeta – moja galaxia na ploche telefónu -->
        <service
            android:name=".wallpaper.GalaxyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/galaxy_wallpaper" />
        </service>
    </application>

</manifest>
